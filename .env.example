# Default is mock/fixtures so CI and local demos stay offline.
NARRATIVERADAR_MOCK=1

# Optional live X recent-search (only used when MOCK=0).
# NARRATIVERADAR_MOCK=0
# NARRATIVERADAR_X_BEARER_TOKEN=
# X_BEARER_TOKEN=
# TWITTER_BEARER_TOKEN=

# Optional knobs
# NARRATIVERADAR_HOURS=24
# NARRATIVERADAR_MIN_SCORE=35
# NARRATIVERADAR_QUERY=(crypto OR solana OR narrative) lang:en -is:retweet
# NARRATIVERADAR_KOL_LIST=ansem,camillo,cobie,hsaka,pag
# NARRATIVERADAR_FIXTURE=/path/to/posts.json
# NARRATIVERADAR_AS_OF=2026-09-18T01:40:00Z
